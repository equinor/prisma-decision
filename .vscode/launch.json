{
	"version": "0.2.0",
	"configurations": [
		{
			"name": ".NET Core Launch (Local)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/prisma-api/src/PrismaApi.Api/bin/Debug/net10.0/PrismaApi.Api.dll",
			"args": [],
			"cwd": "${workspaceFolder}/prisma-api/src",
			"stopAtEntry": false,
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "\\bNow listening on:\\s+(https?://\\S+)"
			},
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Local",
				"ASPNETCORE_URLS": "http://localhost:5199"
			}
		}
	]
}
